[Unit]
Description=CLIProxy query-aware auto-router front service
Documentation=file:/opt/crsproxy/auto-router/README.md
After=network-online.target crsproxy.service
Wants=network-online.target
Requires=crsproxy.service

[Service]
Type=simple
DynamicUser=yes
UMask=0077
RuntimeDirectory=cliproxy-auto-router
RuntimeDirectoryMode=0700
StateDirectory=cliproxy-auto-router
StateDirectoryMode=0700
LoadCredential=client-key:/etc/crsproxy/auto-router-client-key
LoadCredential=base-api-key:/etc/crsproxy/auto-router-base-api-key
ExecStartPre=/usr/bin/python3 /opt/crsproxy/auto-router/render-config --policy /etc/crsproxy/auto-router.yaml --client-key-file %d/client-key --base-api-key-file %d/base-api-key --output /run/cliproxy-auto-router/config.yaml --state-directory /var/lib/cliproxy-auto-router
ExecStart=/opt/crsproxy/auto-router/cliproxy-auto-router -config /run/cliproxy-auto-router/config.yaml --local-model
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/crsproxy/auto-router.yaml /opt/crsproxy/auto-router

[Install]
WantedBy=multi-user.target
