[Unit]
Description=Verify CLIProxy smart-router production soak
After=network-online.target crsproxy.service cliproxy-account-reconciler.service
Wants=network-online.target
Requires=crsproxy.service

[Service]
Type=oneshot
TimeoutStartSec=30s
User=root
Group=root
UMask=0077
StateDirectory=cliproxy-smart-router-soak
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/crsproxy/bin/verify-production-soak
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/crsproxy/management-general.env /etc/crsproxy/account-reconciler.env /opt/crsproxy/bin/verify-production-soak /opt/crsproxy/cli-proxy-api /opt/crsproxy/config.yaml /opt/crsproxy/logs

[Install]
WantedBy=multi-user.target
