[Unit]
Description=Verify CLIProxy smart-router production soak
After=network-online.target crsproxy.service cliproxy-auto-router.service cliproxy-account-reconciler.service
Wants=network-online.target
Requires=crsproxy.service cliproxy-auto-router.service

[Service]
Type=oneshot
TimeoutStartSec=30s
User=root
Group=root
UMask=0077
StateDirectory=cliproxy-smart-router-soak
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/crsproxy/bin/verify-production-soak
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/crsproxy/management-general.env /etc/crsproxy/account-reconciler.env /etc/crsproxy/account-inventory.json /etc/crsproxy/auto-router.yaml /etc/nginx/conf.d/cliproxy-auto-router.conf /etc/systemd/system/crsproxy.service /etc/systemd/system/cliproxy-auto-router.service /etc/systemd/system/cliproxy-account-reconciler.service /etc/systemd/system/cliproxy-account-reconciler.timer /etc/systemd/system/cliproxy-smart-router-soak.service /etc/systemd/system/cliproxy-smart-router-soak.timer /opt/crsproxy/bin/verify-production-soak /opt/crsproxy/bin/account-reconciler /opt/crsproxy/cli-proxy-api /opt/crsproxy/auto-router/cliproxy-auto-router /opt/crsproxy/auto-router/render-config /opt/crsproxy/config.yaml /opt/crsproxy/logs /run/cliproxy-auto-router/config.yaml /var/lib/cliproxy-account-reconciler/journal.jsonl

[Install]
WantedBy=multi-user.target
